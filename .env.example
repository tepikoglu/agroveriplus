# AgroVeri+ Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database (Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/agroveriplus

# IPFS (Phase 2)
# IPFS_API_URL=https://api.pinata.cloud
# IPFS_API_KEY=
# IPFS_API_SECRET=

# Authentication (Phase 3)
# JWT_SECRET=change-this-to-a-random-secret
# JWT_EXPIRY_HOURS=24

# CORS
# CORS_ORIGINS=https://agroveriplus.com,https://www.agroveriplus.com
