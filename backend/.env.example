# ═══════════════════════════════════════════════════
# AgroVeri+ Backend — Environment Variables
# Copy to .env and fill in production values
# ═══════════════════════════════════════════════════

# Application
APP_ENV=development              # development | staging | production
DEBUG=true                       # false in production

# Database
DATABASE_URL=postgresql+asyncpg://agroveri:agroveri@db:5432/agroveriplus

# JWT Authentication
# IMPORTANT: Change this to a random 32+ char secret in production!
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# IPFS — Pinata (optional, leave empty to skip pinning)
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=

# File Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png"]

# CORS — Allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# ─── Features (Sprint 2) ─────────────────────────
# Parcels: No extra config needed (uses DB)
# Notifications: No extra config needed (uses DB)
# External Registry: Mock providers active by default
# Dashboard: No extra config needed (uses DB)

# ─── Future (Sprint 3) ────────────────────────────
# GOOGLE_CLIENT_ID=                # Google OAuth
# SMTP_HOST=smtp.gmail.com         # Email notifications
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SENTINEL_API_KEY=                # Copernicus satellite data
